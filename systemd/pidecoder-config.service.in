[Unit]
Description=PiDecoder Web Administration
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@TARGET@

# Durcissement systemd. S'applique même en root : namespaces de montage
# confinés, syscalls et écritures limités à ce qui est réellement utilisé
# (config caméras, redémarrage des autres services via systemctl).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
#
# AF_NETLINK ajouté pour la découverte ONVIF (voir onvif_client.py,
# _ipv4_interfaces()) : cette fonction énumère les interfaces IPv4 actives
# en lançant `ip -j -4 addr show up`, et `ip` interroge le noyau via une
# socket AF_NETLINK/NETLINK_ROUTE — sans cette autorisation, la socket
# échoue silencieusement (EAFNOSUPPORT), la commande sort en erreur,
# _ipv4_interfaces() renvoie une liste vide, et discover() s'arrête
# immédiatement avec 0 interface détectée : c'est exactement le symptôme
# observé (« Interfaces : Aucune », 0 caméra), alors que le même appel à
# discover() lancé hors service (donc hors de cette restriction) trouve
# les caméras sans problème. Même défaut, même cause, déjà rencontré et
# corrigé pour l'overlay réseau du player natif (voir pidecoder.service.in).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
MemoryDenyWriteExecute=true
ReadWritePaths=@TARGET@/config @REPO_PATH@

Environment=PIDECODER_USER=@SERVICE_USER@
ExecStart=/usr/bin/python3 @TARGET@/scripts/config-web.py --root @TARGET@ --bind @WEB_BIND@ --port @WEB_PORT@ --https-port @WEB_HTTPS_PORT@ --repo-path @REPO_PATH@
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
